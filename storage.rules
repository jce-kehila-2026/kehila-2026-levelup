rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
  
    // Helper function to check if the caller is staff (admin or instructor) and not archived
    function isStaff() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'instructor'] &&
        !firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isArchived', false);
    }
    
    // Helper function to check if the caller is authenticated and not archived
    function isNotArchivedUser() {
      return request.auth != null &&
        !firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isArchived', false);
    }

    match /materials/{allPaths=**} {
      allow read: if isNotArchivedUser();
      allow write: if isStaff();
    }
    match /assignments/{allPaths=**} {
      allow read: if isNotArchivedUser();
      allow write: if isStaff();
    }
  }
}
